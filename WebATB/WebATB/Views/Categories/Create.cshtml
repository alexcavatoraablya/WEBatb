@using WebATB.Models.Categories
@model CategoriesCreateViewModel
@{
    Layout = "MainLayout"; //не використовуємо Layout
}

<h1 class="text-center">Додати категорію</h1>

<form asp-action="Create" class="col-md-6 offset-md-3" enctype="multipart/form-data">
    <div class="mb-3">
        <label asp-for="CategoryName" class="form-label"></label>
        <input asp-for="CategoryName" class="form-control">
        <span asp-validation-for="CategoryName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control">
        <span asp-validation-for="Slug" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="FileImage"></label>
        <input asp-for="FileImage" class="form-control-file">
        <span asp-validation-for="FileImage" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Створити</button>
</form>

@section Scripts {
    <script>
        var txtName = document.getElementById("CategoryName");
        var txtSlug = document.getElementById("Slug");
        //console.log("Slug", txtSlug);
        // відловлюю коли значення і інпуті змінилося тобто перейшли на інший інпут
        txtName.onchange = function(e) {
            console.log("change data", e.target.value);
        };
        // спрацьовує постійно
        txtName.addEventListener("input", (e) => {
            //console.log("input", e.target.value)
            txtSlug.value = slugify(e.target.value);
        });
    </script>
}